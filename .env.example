# ローカル開発用の設定。cp .env.example .env でコピーして使う（.env は Git に入れない）
# docker compose と Spring Boot（backend/src/main/resources/application.yml）の両方が読む

POSTGRES_DB=sns
POSTGRES_USER=sns
POSTGRES_PASSWORD=sns
POSTGRES_PORT=5432

# JWT の署名鍵。32バイト以上のランダムな文字列にする（例：openssl rand -base64 48 の結果を貼る）
JWT_SECRET=

# リフレッシュトークンの Cookie に Secure 属性を付けるか。ローカル（HTTP）は false、本番（HTTPS）は true
REFRESH_TOKEN_COOKIE_SECURE=false

# 画像の保存先（S3）。ローカルは docker compose の LocalStack（4.14.0）を使う。書かなければ下と同じ値になる
# 本番（AWS）では S3_ENDPOINT を空にし、IMAGE_BASE_URL に CloudFront の URL を入れる（アクセスキーは IAM ロールから取得するので書かない）
S3_BUCKET=sns-app-images
AWS_REGION=ap-northeast-1
S3_ENDPOINT=http://localhost:4566
IMAGE_BASE_URL=http://localhost:4566/sns-app-images
